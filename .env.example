# ====================================================
# DECISIONOS — ENVIRONMENT CONFIGURATION EXAMPLE
# ====================================================

# ----------------------------------------------------
# 1. GENERAL & APPLICATION SETTINGS
# ----------------------------------------------------
PROJECT_NAME="DecisionOS"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# ----------------------------------------------------
# 2. SECURITY & AUTHENTICATION (JWT & OAUTH)
# ----------------------------------------------------
# Generate a secure 32+ char secret for production: openssl rand -hex 32
SECRET_KEY="supersecret-decisionos-dev-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM="HS256"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# Magic Link & Email Verification
EMAIL_SENDER_NAME="DecisionOS Security"
EMAIL_SENDER_ADDRESS="noreply@decisionos.ai"
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=587
SMTP_USER="your-smtp-user"
SMTP_PASSWORD="your-smtp-password"

# ----------------------------------------------------
# 3. DATABASE CONNECTION (POSTGRESQL / NEON)
# ----------------------------------------------------
# Standard PostgreSQL URL for SQLAlchemy 2.0 asyncpg driver
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/decisionos"
# Sync database URL for Alembic migrations
SYNC_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/decisionos"

# ----------------------------------------------------
# 4. CACHE & BACKGROUND TASK BROKER (REDIS & CELERY)
# ----------------------------------------------------
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# ----------------------------------------------------
# 5. OBJECT STORAGE (AWS S3 / MINIO COMPATIBLE)
# ----------------------------------------------------
S3_BUCKET_NAME="decisionos-storage"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_ENDPOINT_URL="http://localhost:9000"
S3_USE_SSL=False

# ----------------------------------------------------
# 6. AI & MACHINE LEARNING API KEYS
# ----------------------------------------------------
OPENAI_API_KEY="sk-your-openai-api-key"
GEMINI_API_KEY="your-gemini-api-key"
VECTOR_DB_URL="http://localhost:8000/vector-db"

# ----------------------------------------------------
# 7. FRONTEND SETTINGS (NEXT.JS 15)
# ----------------------------------------------------
NEXT_PUBLIC_APP_NAME="DecisionOS"
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
